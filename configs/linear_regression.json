{
  "model": {
    "id": "linear_regression_v1",
    "name": "Linear Regression (Config)",
    "version": "1.0.0",
    "kind": "library",
    "binding": {
      "module": "model_zoo.examples.models",
      "callable": "linreg_train_and_infer"
    },
    "inputs": ["X", "y"]
  },
  "hyperparameters": {
    "schema": [
      {
        "name": "fit_intercept",
        "dtype": "bool",
        "default": true,
        "description": "Include intercept"
      },
      {
        "name": "feature_name",
        "dtype": "string",
        "default": "X",
        "description": "Label for diagnostics"
      }
    ],
    "values": [
      {
        "model_id": "linear_regression_v1",
        "param": "fit_intercept",
        "value": "true",
        "env": "dev"
      },
      {
        "model_id": "linear_regression_v1",
        "param": "feature_name",
        "value": "scaled_X",
        "env": "dev"
      }
    ]
  },
  "metrics": [
    {
      "metric_id": "r2_v1",
      "name": "R2_Score",
      "version": "1.0.0",
      "direction": "higher_is_better",
      "kind": "library",
      "binding": {
        "module": "model_zoo.examples.metrics",
        "callable": "r2_score"
      }
    },
    {
      "metric_id": "mse_v1",
      "name": "MeanSquaredError",
      "version": "1.0.0",
      "direction": "lower_is_better",
      "kind": "library",
      "binding": {
        "module": "model_zoo.examples.metrics",
        "callable": "mse"
      }
    }
  ],
  "variables": {
    "definitions": [
      {
        "name": "feature_raw",
        "source": "x_values",
        "transforms": [{"id": "identity"}],
        "metadata": {
          "description": "Raw synthetic feature"
        }
      },
      {
        "name": "feature_scaled",
        "source": "feature_raw",
        "transforms": [{"id": "standardize"}],
        "metadata": {
          "description": "Standardized feature"
        }
      },
      {
        "name": "feature_poly",
        "source": "feature_raw",
        "transforms": [
          {
            "id": "poly_features",
            "params": {
              "degree": 2,
              "prefix": "x"
            }
          }
        ]
      },
      {
        "name": "X",
        "source": "feature_scaled",
        "transforms": [{"id": "identity"}]
      },
      {
        "name": "y",
        "source": "y_values"
      }
    ],
    "groups": [
      {
        "id": "feature_views",
        "variables": ["feature_raw", "feature_scaled"],
        "transforms": [
          {
            "id": "stack",
            "params": {
              "keys": ["raw", "scaled"]
            }
          }
        ],
        "output_name": "feature_bundle"
      }
    ]
  },
  "evaluation": {
    "metric_ids": ["r2_v1", "mse_v1"],
    "y_true_key": "y",
    "compute_train": true,
    "compute_valid": true
  },
  "context": {
    "timeout_s": 60
  }
}
