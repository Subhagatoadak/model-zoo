{
  "model": {
    "id": "pymc_hier_mmm_v1",
    "name": "Hierarchical Marketing Mix (PyMC)",
    "version": "1.0.0",
    "kind": "library",
    "binding": {
      "module": "model_zoo.examples.pymc_models",
      "callable": "pymc_hierarchical_mmm"
    },
    "inputs": ["X", "y"]
  },
  "hyperparameters": {
    "schema": [
      {"name": "draws", "dtype": "int", "default": 400},
      {"name": "tune", "dtype": "int", "default": 400},
      {"name": "target_accept", "dtype": "float", "default": 0.9},
      {"name": "chains", "dtype": "int", "default": 2},
      {"name": "cores", "dtype": "int", "default": 1},
      {"name": "compute_convergence_checks", "dtype": "bool", "default": true},
      {"name": "feature_names", "dtype": "list", "default": ["tv", "radio", "social"]},
      {"name": "geo_key", "dtype": "string", "default": "geo"},
      {"name": "brand_key", "dtype": "string", "default": "brand"},
      {"name": "sigma_distribution", "dtype": "string", "default": "half_normal"},
      {"name": "sigma_scale", "dtype": "float", "default": 5.0},
      {"name": "sigma_shape", "dtype": "float", "default": 2.0},
      {"name": "sigma_rate", "dtype": "float", "default": 1.0}
    ],
    "values": [
      {"model_id": "pymc_hier_mmm_v1", "param": "draws", "value": 400, "env": "dev"},
      {"model_id": "pymc_hier_mmm_v1", "param": "tune", "value": 400, "env": "dev"},
      {"model_id": "pymc_hier_mmm_v1", "param": "target_accept", "value": 0.9, "env": "dev"},
      {"model_id": "pymc_hier_mmm_v1", "param": "chains", "value": 2, "env": "dev"},
      {"model_id": "pymc_hier_mmm_v1", "param": "cores", "value": 1, "env": "dev"},
      {"model_id": "pymc_hier_mmm_v1", "param": "compute_convergence_checks", "value": "true", "env": "dev"},
      {"model_id": "pymc_hier_mmm_v1", "param": "sigma_distribution", "value": "half_normal", "env": "dev"},
      {"model_id": "pymc_hier_mmm_v1", "param": "sigma_scale", "value": 5.0, "env": "dev"},
      {"model_id": "pymc_hier_mmm_v1", "param": "sigma_shape", "value": 2.0, "env": "dev"},
      {"model_id": "pymc_hier_mmm_v1", "param": "sigma_rate", "value": 1.0, "env": "dev"}
    ]
  },
  "coefficients": {
    "intercept": {
      "distribution": "normal",
      "mu": 80.0,
      "sigma": 20.0
    },
    "variables": [
      {
        "name": "tv",
        "distribution": "normal",
        "mu": 2.0,
        "sigma": 1.0
      },
      {
        "name": "radio",
        "distribution": "half_normal",
        "sigma": 1.0
      },
      {
        "name": "social",
        "distribution": "gamma",
        "shape": 2.0,
        "rate": 1.0
      }
    ]
  },
  "metrics": [
    {
      "metric_id": "r2_v1",
      "name": "R2_Score",
      "version": "1.0.0",
      "direction": "higher_is_better",
      "kind": "library",
      "binding": {
        "module": "model_zoo.examples.metrics",
        "callable": "r2_score"
      }
    },
    {
      "metric_id": "mse_v1",
      "name": "MeanSquaredError",
      "version": "1.0.0",
      "direction": "lower_is_better",
      "kind": "library",
      "binding": {
        "module": "model_zoo.examples.metrics",
        "callable": "mse"
      }
    }
  ],
  "variables": {
    "definitions": [
      {"name": "tv", "source": "tv_spend"},
      {"name": "radio", "source": "radio_spend"},
      {"name": "social", "source": "social_spend"},
      {"name": "geo_labels", "source": "geo_labels"},
      {"name": "brand_labels", "source": "brand_labels"},
      {"name": "X", "source": "marketing_rows"},
      {"name": "y", "source": "sales"}
    ],
    "groups": [
      {
        "id": "spend_channels",
        "variables": ["tv", "radio", "social"],
        "transforms": [
          {
            "id": "stack",
            "params": {"keys": ["tv", "radio", "social"]}
          }
        ],
        "output_name": "channel_spend_views"
      }
    ]
  },
  "evaluation": {
    "metric_ids": ["r2_v1", "mse_v1"],
    "y_true_key": "y",
    "compute_train": true,
    "compute_valid": true
  },
  "context": {
    "timeout_s": 240
  }
}
